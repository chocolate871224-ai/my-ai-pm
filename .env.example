# ── ai-pm-starter environment ──
# Copy this file to `.env` and fill in as needed.
# Everything works in mock mode out of the box — you only need real values
# when you want to sync with your real Google Calendar.

# Google Calendar (MCP Server — sync-calendar)
# Mock mode by default (in-memory, no network). Set to false after `npm run cal:auth`.
GCAL_MOCK_MODE=true
GCAL_CLIENT_ID=your_google_oauth_client_id_here
GCAL_CLIENT_SECRET=your_google_oauth_client_secret_here
GCAL_REFRESH_TOKEN=set_by_npm_run_cal_auth
GCAL_CALENDAR_ID=primary
